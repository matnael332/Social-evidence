{
  "name": "social-evidence",
  "version": "0.3.0",
  "private": true,
  "description": "Chrome extension for one-click, local-only documentation of social media posts as evidence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --config vite.adapter.config.ts",
    "check:build": "node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
